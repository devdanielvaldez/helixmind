# Ollama API Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_TIMEOUT=120.0

# Models Configuration
# Recommended reasoning model: deepseek-r1:1.5b, mistral:7b, qwen2.5-coder:7b, llama3.2:3b
OLLAMA_DEFAULT_MODEL=llama3.2:3b
OLLAMA_REASONING_MODEL=deepseek-r1:1.5b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest

# Scientific Research Settings
DEFAULT_MAX_HYPOTHESES=3
DEFAULT_LITERATURE_LIMIT=5
CACHE_DIR=.cache
DATA_DIR=data

# Biomedical APIs Configuration
NCBI_API_KEY=your_ncbi_api_key_here
NCBI_EMAIL=your_email@example.com
NCBI_TOOL=helixmind-platform

